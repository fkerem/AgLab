# Copy this file to .env and replace every CHANGE_ME value before starting.
# Never commit .env.

COMPOSE_PROJECT_NAME=aglab

# Course VM network binding.
# For Tailscale-first deployments, set this to the output of: tailscale ip -4
# For local-only testing on the VM, keep 127.0.0.1.
BIND_IP=127.0.0.1

# PostgreSQL / TimescaleDB
POSTGRES_DB=aglab
POSTGRES_USER=aguser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_ADMIN_PASSWORD

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_ADMIN_PASSWORD
GRAFANA_DOMAIN=127.0.0.1
GRAFANA_ROOT_URL=http://127.0.0.1:3000/

# Student provisioning
STUDENT_COUNT=9
STUDENT_PASSWORD_LENGTH=18
PREPROVISION_STUDENT_DATASOURCES=false

# Optional public HTTPS via Caddy profile.
# DNS is optional. Leave these placeholders until using --profile public_https.
DOMAIN=CHANGE_ME_EXAMPLE_EDU_OR_HOSTNAME
LETSENCRYPT_EMAIL=CHANGE_ME_TEACHER_EMAIL
