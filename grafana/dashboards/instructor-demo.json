          "rawQuery": true,
          "rawSql": "SELECT\n  m.ts AS \"time\",\n  s.station_name AS metric,\n  m.soil_moisture AS value\nFROM measurements m\nJOIN stations s ON s.station_id = m.station_id\nWHERE $__timeFilter(m.ts)\nORDER BY m.ts;",
          "refId": "A"
        }
      ],
      "title": "Soil Moisture by Station",
      "type": "timeseries"
    },
