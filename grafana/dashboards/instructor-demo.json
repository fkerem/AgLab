          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "instructor-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('1 day', m.ts) AS \"time\",\n  s.station_name AS metric,\n  sum(m.rainfall_mm) AS value\nFROM measurements m\nJOIN stations s ON s.station_id = m.station_id\nWHERE $__timeFilter(m.ts)\nGROUP BY 1, s.station_name\nORDER BY 1;",
